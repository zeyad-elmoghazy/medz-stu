# Demo mode — bypasses Supabase and stores auth in localStorage.
# Set to "1" ONLY for reviewer walkthroughs without a real backend.
# Any other value (unset, "0", "false") requires the Supabase
# credentials below to be present, or the app will refuse to boot
# in production.
NEXT_PUBLIC_DEMO=0

# Supabase — server + auth
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-only; bypasses RLS for admin routes and
# scripts. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis — caching + rate limiting layer
# Create a database at https://console.upstash.com/redis, then
# copy the "REST URL" and "REST Token" from the database's REST
# API tab. Leave blank to skip caching (lib/cache.ts and
# lib/rate-limit.ts both degrade to no-ops).
UPSTASH_REDIS_URL=your_upstash_url
UPSTASH_REDIS_TOKEN=your_upstash_token
