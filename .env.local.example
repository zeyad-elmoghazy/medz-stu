# Copy to .env.local (gitignored). Never commit real values.
# These six are the only variables the app reads.

# Demo mode — bypasses Supabase and stores auth in localStorage.
# Honoured ONLY outside production builds (NODE_ENV !== 'production'):
# NEXT_PUBLIC_* values are inlined into the browser bundle, so a stray
# "1" in a host's env must never be able to switch off the auth gate on
# the live site. For local reviewer walkthroughs only.
NEXT_PUBLIC_DEMO=0

# Supabase — server + auth. These two are PUBLIC by design (they ship
# in the browser bundle); the anon key is only as powerful as RLS and
# table privileges allow (see supabase/migrations/038).
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — SERVER ONLY. Bypasses RLS entirely. Used by the
# account-removal, quiz-submit, progress, stats and leaderboard routes
# after they have authenticated the caller. Must never carry a
# NEXT_PUBLIC_ prefix; lib/supabase-service.ts is `server-only` so the
# build fails if it is ever imported client-side. Rotate it in the
# Supabase dashboard if it is ever pasted somewhere it shouldn't be.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis — caching + rate limiting (server only).
# Leave blank to skip: lib/cache.ts and lib/rate-limit.ts degrade to
# no-ops — meaning NO login/API rate limiting. Set both in production.
UPSTASH_REDIS_URL=your_upstash_url
UPSTASH_REDIS_TOKEN=your_upstash_token
